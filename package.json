{
  "name": "tecnomovil-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --project tecnomovil-store --configuration development --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test",
    "test:images": "node scripts/check-product-images.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:routing": "node scripts/check-routing.mjs",
